---
import { followConfig } from "@/config";
import FollowPanel from "./followPanel.astro";


interface Props {
    class?: string;
    style?: string;
    side?: string;
}
const { class: className, style, side = "default" } = Astro.props;
---

<FollowPanel
    id={`linkedin-${side}`}
    config={followConfig.linkedin}
    badgeIcon="fa6-brands:linkedin-in"
    buttonIcon="fa6-brands:linkedin"
    color="#0a66c2"
    hoverColor="#004182"
    class={className}
    style={style}
/>

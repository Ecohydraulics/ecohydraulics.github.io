---
import { Icon } from "astro-icon/components";

import { navbarConfig, siteConfig } from "@/config";
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset, type NavbarLink } from "@/types/config";
import { url } from "@utils/url";
import { getNavbarTransparentModeForWallpaperMode, getDefaultWallpaperMode } from "@utils/wallpaper";
import NavLinks from "@components/navbar/navLinks.astro";
import NavMenu from "@components/navbar/navMenu.svelte";
import Search from "@components/navbar/search.svelte";
import Translator from "@components/navbar/translator.svelte";
import LightDarkSwitch from "@components/navbar/lightDarkSwitch.svelte";
import WallpaperSwitch from "@components/navbar/wallpaperSwitch.svelte";


const className = Astro.props.class;

// Get the navbar transparency mode config - reads the correct config based on the current wallpaper mode
const navbarTransparentMode = getNavbarTransparentModeForWallpaperMode(getDefaultWallpaperMode());

let links: NavbarLink[] = navbarConfig.links.map(
    (item: NavbarLink | LinkPreset): NavbarLink => {
        if (typeof item === "number") {
            return LinkPresets[item];
        }
        return item;
    },
);
---

<div id="navbar" class="z-50 onload-animation-down px-3 sm:px-6 md:px-0" data-transparent-mode={navbarTransparentMode}>
    <div class="absolute h-8 left-0 right-0 -top-8 bg-(--card-bg) transition"></div> <!-- used for onload animation -->
    <div id="navbar-inner" class:list={[
        className,
        "overflow-visible! max-w-(--page-width) h-18 mx-auto flex items-center justify-between md:px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-13 px-5 font-bold active:scale-95" id="navbar-home">
            <div class="flex flex-row text-(--primary) items-center text-md">
                <Icon name="material-symbols:home-pin-outline" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="items-center navbar-nav-links" id="navbar-nav-links">
            {links.map((l) => {
                return <NavLinks link={l} />;
            })}
        </div>
        <div class="flex items-center navbar-buttons" id="navbar-buttons">
            <Search client:idle></Search>
            <Translator client:idle></Translator>
            <LightDarkSwitch client:idle></LightDarkSwitch>
            <WallpaperSwitch client:idle></WallpaperSwitch>
            <NavMenu client:idle links={links}></NavMenu>
        </div>
    </div>
</div>

<script is:inline>
// Dynamically collapse the desktop nav links into the hamburger menu whenever
// the row would otherwise overlap the top-right buttons. Replaces the old fixed
// `md` breakpoint so it adapts to the actual link/label widths and language.
(function initNavCollapse() {
    var BUFFER = 24; // px of breathing room before we consider the row "tight"

    function measureNaturalWidth(el) {
        // Measure the element's natural (un-shrunk) width regardless of its
        // current display/grid constraints. Synchronous, so no visible flicker.
        var prev = el.getAttribute("style");
        el.style.position = "absolute";
        el.style.visibility = "hidden";
        el.style.display = "flex";
        el.style.width = "max-content";
        el.style.maxWidth = "none";
        el.style.left = "-9999px";
        var w = el.scrollWidth;
        if (prev === null) el.removeAttribute("style");
        else el.setAttribute("style", prev);
        return w;
    }

    function update() {
        var navbar = document.getElementById("navbar");
        var inner = document.getElementById("navbar-inner");
        var home = document.getElementById("navbar-home");
        var navLinks = document.getElementById("navbar-nav-links");
        var buttons = document.getElementById("navbar-buttons");
        if (!navbar || !inner || !home || !navLinks || !buttons) return;

        // Force the expanded layout so the buttons row excludes the hamburger
        // and the home/buttons widths reflect the non-collapsed state.
        navbar.classList.remove("nav-collapsed");
        navbar.classList.add("nav-expanded");

        var cs = getComputedStyle(inner);
        var padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
        var available = inner.clientWidth - padX;
        var needed = home.offsetWidth + measureNaturalWidth(navLinks) + buttons.offsetWidth + BUFFER;

        if (needed > available) {
            navbar.classList.remove("nav-expanded");
            navbar.classList.add("nav-collapsed");
        }
    }

    var scheduled = false;
    function schedule() {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(function () {
            scheduled = false;
            update();
        });
    }

    // Initial, synchronous run avoids a flash of the wrong layout.
    update();

    window.addEventListener("resize", schedule, { passive: true });
    // Re-measure once webfonts/icons settle, which can change link widths.
    if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(schedule);
    }
    window.addEventListener("load", schedule, { passive: true });
    window.initNavCollapse = update;
})();
</script>

<script>
// Add scroll detection logic for semifull mode
function initSemifullScrollDetection() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    const transparentMode = navbar.getAttribute('data-transparent-mode');
    if (transparentMode !== 'semifull') return;

    // Remove the previous scroll event listener (if present)
    if (window.semifullScrollHandler) {
        window.removeEventListener('scroll', window.semifullScrollHandler);
    }

    let ticking = false;

    function updateNavbarState() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const threshold = 50; // scroll threshold

        if (scrollTop > threshold) {
            navbar?.classList.add('scrolled');
        } else {
            navbar?.classList.remove('scrolled');
        }

        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateNavbarState);
            ticking = true;
        }
    }

    // Save the new event handler reference
    window.semifullScrollHandler = requestTick;

    // Listen for scroll events
    window.addEventListener('scroll', requestTick, { passive: true });

    // Initialize the state
    updateNavbarState();
}

// Expose the function on the global object for use during page transitions
window.initSemifullScrollDetection = initSemifullScrollDetection;

// Initialize scroll detection after the page finishes loading
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSemifullScrollDetection);
} else {
    initSemifullScrollDetection();
}
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}